{
	"$schema": "node_modules/wrangler/config-schema.json",
	// OpenNext が生成する Worker を包む自前の入口。チャットの WebSocket をここで振り分ける
	"main": "worker/index.ts",
	"name": "frontend",
	"compatibility_date": "2026-07-31",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"routes": [
		{ "pattern": "donarai.com", "custom_domain": true }
	],
	// workers.dev とプレビュー用の URL を無効にし、donarai.com 以外の入口をなくす。
	// 別の入口があると、donarai.com に設定した WAF のルールを回り道されてしまう
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-site-db",
			"database_id": "9162f008-cf43-426f-b770-fb1a06d19f79",
			"migrations_dir": "migrations"
		}
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "frontend"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// チャットルーム。クラスは worker/chat-room.ts
	"durable_objects": {
		"bindings": [
			{ "name": "CHAT_ROOM", "class_name": "ChatRoom" }
		]
	},
	// 無料プランで使える SQLite 型の Durable Object として登録する
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }
	]
}